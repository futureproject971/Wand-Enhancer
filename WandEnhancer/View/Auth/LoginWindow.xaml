<Window x:Class="WandEnhancer.View.Auth.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WG Enhancer"
        Width="430"
        Height="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#09090B"
        Foreground="#FAFAFA"
        FontFamily="{StaticResource Inter}"
        Loaded="OnLoaded">
    <Border Margin="12"
            Padding="28"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="#27272A"
            Background="#0C0C0F">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel HorizontalAlignment="Center">
                <Image Width="190"
                       Height="72"
                       Stretch="Uniform"
                       Source="/Assets/Branding/world-games-logo.png"/>
                <TextBlock Margin="0 12 0 0"
                           Text="WG ENHANCER"
                           FontSize="20"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Margin="0 2 0 0"
                           Text="WORLD GAMES"
                           Foreground="#A1A1AA"
                           FontSize="10"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <TextBlock Grid.Row="1"
                       Margin="0 25 0 7"
                       Text="LICENSE KEY"
                       FontSize="11"
                       Foreground="#D4D4D8"/>

            <TextBox x:Name="LicenseKeyBox"
                     Grid.Row="2"
                     Height="38"
                     Padding="10 8"
                     Background="#18181B"
                     Foreground="White"
                     BorderBrush="#3F3F46"
                     CaretBrush="White"
                     FontSize="13"/>

            <Button x:Name="LoginButton"
                    Grid.Row="3"
                    Margin="0 14 0 0"
                    Height="40"
                    Content="ENTRAR"
                    IsDefault="True"
                    Click="OnLogin"
                    Background="#E11D2E"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="Bold"
                    Cursor="Hand"/>

            <TextBlock x:Name="StatusText"
                       Grid.Row="4"
                       Margin="0 12 0 0"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="#A1A1AA"
                       FontSize="11"/>
        </Grid>
    </Border>
</Window>
